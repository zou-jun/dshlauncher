# ── 环境与工具缓存 ────────────────────────────────────────────────
.venv/
.cache/
.pytest_cache/
.ruff_cache/

# ── 构建产物 ─────────────────────────────────────────────────────
# scripts/build.py 的中间产物与 dist；app/ 是部署目录（含运行时数据）
.build/
app/
build/
dist/
*.egg-info/

# ── 运行时数据（源码模式）─────────────────────────────────────────
.dshlauncher/

# ── Python 字节码 ────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── 编辑器与系统文件 ─────────────────────────────────────────────
.idea/
.vscode/
Thumbs.db
desktop.ini
.DS_Store
